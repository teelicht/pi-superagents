{
  "name": "@teelicht/pi-superagents",
  "version": "0.12.0",
  "packageManager": "pnpm@11.6.0",
  "description": "Pi extension for Superpowers workflows: recon, research, implementation, review, and debug",
  "author": "Thomas Lichtenecker",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teelicht/pi-superagents.git"
  },
  "homepage": "https://github.com/teelicht/pi-superagents#readme",
  "bugs": {
    "url": "https://github.com/teelicht/pi-superagents/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "subagents",
    "ai",
    "agents",
    "cli",
    "superpowers"
  ],
  "bin": {
    "pi-superagents": "install.mjs"
  },
  "files": [
    "src/",
    "scripts/",
    "agents/",
    "docs/",
    "default-config.json",
    "config.example.json",
    "*.mjs",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "postinstall": "node --experimental-strip-types ./scripts/migrate-package-install.ts",
    "prepublishOnly": "pnpm test",
    "debug:pi-local": "node --experimental-strip-types ./scripts/local-extension-install.ts",
    "install:local": "pnpm run debug:pi-local",
    "qa": "biome check --write && tsc --noEmit && pnpm run test:all",
    "lint": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "node --experimental-strip-types --test test/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --import ./test/support/register-loader.mjs --test test/integration/*.test.ts",
    "test:e2e": "node --experimental-strip-types --import ./test/support/register-loader.mjs --test test/e2e/*.test.ts",
    "test:all": "pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e"
  },
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@earendil-works/pi-agent-core": "^0.82.1",
    "@earendil-works/pi-ai": "^0.82.1",
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@earendil-works/pi-tui": "^0.82.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "fallow": "^3.8.0",
    "typebox": "^1.3.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
